import QtQuick

Item {
    id: root
    readonly property string lang: window.selectedLanguage

    // ── Helper internal ───────────────────────────────────────
    function t(id_ID, en, zh, ja, ko, btk, jv, es, de,
               fr, ar, pt, hi, vi, fil, tr, ru, it, nl,
               ms, su, min, bug, th) {
        switch (root.lang) {
            case "English":    return en
            case "中文":        return zh
            case "日本語":      return ja
            case "한국어":      return ko
            case "Batak":      return btk
            case "Jawa":       return jv
            case "Español":    return es
            case "Deutsch":    return de
            case "Français":   return fr
            case "العربية":    return ar
            case "Português":  return pt
            case "हिन्दी":     return hi
            case "Tiếng Việt": return vi
            case "Filipino":   return fil
            case "Türkçe":     return tr
            case "Русский":    return ru
            case "Italiano":   return it
            case "Nederlands": return nl
            case "Melayu":     return ms
            case "Sunda":      return su
            case "Minang":     return min
            case "Bugis":      return bug
            case "ภาษาไทย":    return th
            default:           return id_ID   // Indonesia (default)
        }
    }

